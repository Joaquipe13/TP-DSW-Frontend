{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "dom"],
    "jsx": "react-jsx",
    "types": ["cypress", "node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true
  },
  "include": ["cypress/**/*.ts", "cypress/**/*.tsx", "cypress/support/index.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}
