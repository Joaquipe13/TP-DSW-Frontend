{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS", // Cambiado a CommonJS para Node.js
    "lib": ["ES2020"],
    "types": ["node"], // Asegúrate de que los tipos de Node.js estén disponibles
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
